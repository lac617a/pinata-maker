# Copia este archivo como .env y llena los valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=https://maker.profiya.com

# Credenciales de una cuenta de prueba, solo para pnpm test:integration.
# Sin ellas, la suite de integración se salta.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# Límite diario (docs/usage.md). El secreto firma las huellas del visitante
# anónimo: 32 caracteres al azar como mínimo, distinto en cada entorno.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
USAGE_HASH_SECRET=
# Opcionales: si faltan, 3 sin cuenta, 20 con cuenta y 200 de pago.
USAGE_LIMIT_ANONYMOUS=
USAGE_LIMIT_REGISTERED=
USAGE_LIMIT_PAID=
